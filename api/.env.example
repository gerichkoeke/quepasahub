# Application
NODE_ENV=production
PORT=3000
ADMIN_TOKEN=change-this-secure-token

# Database
DATABASE_URL=postgresql://postgres:your-secure-password@integrador_db:5432/integrador?schema=public

# Waha Configuration
WAHA_HOST=https://waha.seudominio.com.br
WAHA_API_KEY=
WAHA_API_BASE_PATH=/api
WAHA_SESSIONS_ENDPOINT=/sessions
WAHA_MESSAGES_ENDPOINT=/sessions/{sessionId}/messages
WAHA_WEBHOOK_ENDPOINT=/sessions/{sessionId}/webhook

# Typebot Configuration
TYPEBOT_HOST=https://typebot.seudominio.com.br
TYPEBOT_FLOW_ID=
TYPEBOT_API_KEY=
TYPEBOT_API_BASE_PATH=/api/v1
TYPEBOT_INCOMING_ENDPOINT=/typebots/{flowId}/startChat

# Webhook Configuration
WEBHOOK_BASE_URL=https://integrador.seudominio.com.br/api
SYSTEM_BASE_URL=https://integrador.seudominio.com.br

# CORS
CORS_ORIGIN=https://integrador.seudominio.com.br

# Logging
LOG_LEVEL=info
